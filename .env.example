# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

OPENAI_API_KEY=your_openai_api_key_here

# Comma-separated list of frontend origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Minimum cosine similarity (0-1) a retrieved chunk must hit before the LLM
# is asked to answer from it. Below this, the system reports no relevant
# information instead of guessing. This is an unvalidated heuristic —
# tune it for your documents/embedding model, don't treat it as calibrated.
RAG_MIN_SIMILARITY=0.15
